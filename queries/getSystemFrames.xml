<query id="getSystemFrames" action="select">
  <tables>
    <table name="img_boarder_frames" />
  </tables>
  <columns>
    <column name="*" />
  </columns>
  <conditions>
    <condition operation="equal" column="member_srl" default="0" />
  </conditions>
  <navigation>
    <index var="sort_index" default="frame_srl" order="asc" />
  </navigation>
</query>
