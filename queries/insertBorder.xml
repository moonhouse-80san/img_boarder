<query id="insertBorder" action="insert">
  <tables>
    <table name="img_boarder" />
  </tables>
  <columns>
    <column name="document_srl" var="document_srl" notnull="notnull" />
    <column name="module_srl" var="module_srl" default="0" />
    <column name="border_width" var="border_width" default="0" />
    <column name="border_color" var="border_color" default="#ffaa56" />
    <column name="border_style" var="border_style" default="solid" />
    <column name="shadow" var="shadow" default="N" />
    <column name="min_image_width" var="min_image_width" default="350" />
    <column name="regdate" var="regdate" default="curdate()" />
  </columns>
</query>
