<query id="getItems" action="select">
  <tables>
    <table name="img_boarder_items" />
  </tables>
  <columns>
    <column name="*" />
  </columns>
  <conditions>
    <condition operation="equal" column="document_srl" var="document_srl" required="true" />
  </conditions>
  <navigation>
    <index var="sort_index" default="item_srl" order="asc" />
  </navigation>
</query>
